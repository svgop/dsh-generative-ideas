{
  "name": "dsh-generative-ideas",
  "version": "0.1.3",
  "description": "Roadmap ideation for DeepSeek Harness: generate and compare distinct roadmap options via headless agent runs, pick the one that fits, export as goal.md, and dispatch it to an agent in the chosen workspace.",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh",
    "ideation",
    "roadmap",
    "planning",
    "goal-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savageops/dsh-generative-ideas.git"
  },
  "homepage": "https://github.com/savageops/dsh-generative-ideas#readme",
  "bugs": {
    "url": "https://github.com/savageops/dsh-generative-ideas/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.6-0 || >=0.2.0-rc.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test src/*.test.mjs"
  }
}